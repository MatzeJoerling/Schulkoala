      "fingerprint": "0bd6b9c0600b5eda01b5d1761a1a8d37940abc50f43ef57af1ed4269f8774462"
    },
    {
      "key": "st.c1.out.0",
      "text": "Der Papagei war es! Er hat das Ei nur warm gehalten, weil es so kalt war.",
      "file": "st.c1.out.0.mp3",
      "fingerprint": "f5cb68d32a4d8cd2c887d1c599dcf0de8293e3565d40fb4cdbfa2f485ca793fb"
    },
