    {
      "key": "st.c1.in.0",
      "text": "Oh nein! Im Dino-Park ist das Dino-Ei verschwunden!",
      "file": "st.c1.in.0.mp3",
      "fingerprint": "cdf255aca5f9f3a1ff00de282238803c3f5bcbfc91dec64c3e93cc4f1ee1a8f3"
    },
    {
      "key": "st.c1.in.1",
      "text": "Kommst du mit? Wir sind die Koala-Detektei und suchen Hinweise!",
      "file": "st.c1.in.1.mp3",
      "fingerprint": "541523abbe9eff858f203e10a0df4cde3c1b3db5fd9282d74db343ba99ef919f"
    },
    {
      "key": "cl.c1.0",
      "text": "Hier liegt eine Feder!",
      "file": "cl.c1.0.mp3",
      "fingerprint": "2b0584d8c935386ce69e99974cde77004828e49a1eeef76f75bbfb3ce4dd6b51"
    },
    {
      "key": "cs.c1.0",
      "text": "Der Dieb, der das Ei geklaut hat, hat also Federn.",
      "file": "cs.c1.0.mp3",
      "fingerprint": "61ba29445fd0e0aa1fc9413382c66fdfad829064d4d141b56e61a5086de2159b"
    },
    {
      "key": "cl.c1.1",
      "text": "Die Spuren enden hoch oben im Baum.",
      "file": "cl.c1.1.mp3",
      "fingerprint": "c614e17442ce91a404ed7747ddc62c180928ec5270cf5dfa2fa6e46ac3d85d14"
    },
    {
      "key": "cs.c1.1",
      "text": "Der Dieb kann also fliegen oder klettern. Er ist hoch oben im Baum.",
      "file": "cs.c1.1.mp3",
      "fingerprint": "71e71fb084763641adcd2c5382b0b5a72b19dc609938ae8070f02f1cf0eea5c3"
    },
    {
      "key": "cl.c1.2",
      "text": "Jemand hat Nuss-Krümel fallen lassen.",
      "file": "cl.c1.2.mp3",
      "fingerprint": "4147115b8b886f0e9abe19fff5e0e883fbf01bcd29f9f8a6647575e16ddcd630"
    },
    {
      "key": "cs.c1.2",
      "text": "Der Dieb mag also Nüsse.",
      "file": "cs.c1.2.mp3",
      "fingerprint": "ccefbb74ab3572793254fe871d5352bfab7679e12fade1137c27a3090dc7aa98"
    },
    {
      "key": "cl.c1.3",
      "text": "Und da ruft jemand: Hallo, Hallo!",
      "file": "cl.c1.3.mp3",
      "fingerprint": "5c683d735c5cf01c1c9a4286255e2bc125fc86184ecf473acbf7f92aa7051be6"
    },
    {
      "key": "cs.c1.3",
      "text": "Der Dieb kann also sprechen!",
      "file": "cs.c1.3.mp3",
      "fingerprint": "94cb1b46f74751ca7d44255b591b182d3020b51a9c6d0772e1a1d4e9f00765be"
    },
    {
      "key": "cl.c1.4",
      "text": "Das Ei liegt warm zugedeckt mit Blättern.",
      "file": "cl.c1.4.mp3",
      "fingerprint": "547a34ae23b78dff50173c73e8338482a63174ccbc3e31c0e090e807a44c897a"
    },
    {
      "key": "cs.c1.4",
      "text": "Der Dieb wollte das Ei also warm halten. Er hat es nicht böse gemeint.",
      "file": "cs.c1.4.mp3",
      "fingerprint": "ece3f069b746c95f9a6a3f326b6d8365afac957c9cd86a8c2895e54727bd5b0e"
    },
    {
      "key": "sp.c1.pinguin",
      "text": "Ein Pinguin kann nicht auf einen Baum fliegen.",
      "file": "sp.c1.pinguin.mp3",
      "fingerprint": "b6981e01f257aa1407bc81430f1d280985cc755910bb09cf876a84b614fc4b4d"
    },
    {
      "key": "sp.c1.maus",
      "text": "Eine Maus hat keine Federn.",
